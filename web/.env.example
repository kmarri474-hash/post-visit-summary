# API base URL for the FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000

# --- SSO feature flag ------------------------------------------------------
# Master switch. Set to "false" to bypass SSO entirely and run the app as
# an anonymous dev user (no MSAL init, no /login redirect, no Bearer token).
# Anything other than the literal string "false" keeps SSO enabled.
# NEVER deploy a build with VITE_SSO_ENABLED=false.
VITE_SSO_ENABLED=true

# --- Microsoft Entra ID (SSO via MSAL.js) ---------------------------------
# These values are public (SPA is a public client using PKCE — no secret).
# Vite inlines VITE_* at build time, so set them per environment when running
# `npm run build` (e.g. via Docker --build-arg).

VITE_MSAL_CLIENT_ID=2b65c52d-dcca-464b-ab0a-097a737f9eb6
VITE_MSAL_TENANT_ID=db05faca-c82a-4b9d-b9c5-0f64b6755421

# Must EXACTLY match a redirect URI registered in HCP SSO self-service
# (trailing slash matters). Examples:
#   local dev: http://localhost:5173/
#   stage:     https://stage-clinical.optum.com/
VITE_MSAL_REDIRECT_URI=http://localhost:5173/
VITE_MSAL_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/

# Custom API scope minted for this client by HCP SSO.
VITE_MSAL_API_SCOPE=api://2b65c52d-dcca-464b-ab0a-097a737f9eb6/openid
