# ==== UHG UAIS (OAuth2 client-credentials) ====
UAIS_TOKEN_URL=https://api.uhg.com/oauth/token
HCP_CLIENT_ID=replace-me
# NB: env var name keeps the original (typo'd) spelling used by the UHG platform.
HCP_CLIENT_SECRETE=replace-me
HCP_SCOPE=replace-me

# ==== Azure OpenAI (via UAIS) ====
UAIS_COMPLETIONS_ENDPOINT=https://YOUR-UAIS-HOST
UAIS_API_VERSION=2024-08-01-preview
UAIS_DEPLOYMENT=gpt-4o
UAIS_WHISPER_DEPLOYMENT=whisper
UAIS_PROJECT_ID=replace-me

# ==== Postgres (via Podman, pattern from hs-summarization-agents-fastapi) ====
# Use 127.0.0.1 (not localhost) to avoid IPv6/local-pg collisions.
PG_HOST=127.0.0.1
PG_PORT=55432
PG_DATABASE=pvs
PG_USER=postgres
PG_PASSWORD=postgres
# DATABASE_URL is derived from PG_* if unset. Set it explicitly to override.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:55432/pvs

# ==== API ====
APP_ENV=dev
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AGENT_CONFIDENCE_FLOOR=0.7
AGENT_MODEL_TEMPERATURE=0.2

# ==== Frontend ====
VITE_API_BASE_URL=http://localhost:8000
